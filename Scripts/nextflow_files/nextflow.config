// ─────────────────────────────────────────────────────────────────────────────
//  nextflow.config
// ─────────────────────────────────────────────────────────────────────────────

manifest {
    name        = 'af3-haddock3-pipeline'
    description = 'AlphaFold3 + HADDOCK3 protein-ligand docking at scale'
    version     = '1.0.0'
    nextflowVersion = '>=23.10'
}

params {
    input_csv         = "jobs.csv"
    outdir            = "results"
    pipeline_script   = "scripts/pipeline.py"
    singularity_image = "/scratch/sguirale/AlphaFold3/image/alphafold3.sif"
    model_params      = "/projects/datasets/alphafold/3.0.0/weights"
    databases         = "/scratch/sguirale/AlphaFold3/databases"
    code_dir          = "/scratch/sguirale/AlphaFold3/code"
    max_gpus          = 20
    max_retries       = 2
    tracedir          = "${params.outdir}/pipeline_info"
}

// ─────────────────────────────────────────────────────────────────────────────
//  Slurm executor
// ─────────────────────────────────────────────────────────────────────────────
executor {
    name            = 'slurm'
    queueSize       = 500          // max jobs sitting in Slurm queue at once
    pollInterval    = '30 sec'     // how often to check job status
    submitRateLimit = '50/1min'    // throttle submissions to avoid scheduler spam
}

// ─────────────────────────────────────────────────────────────────────────────
//  Process resource labels
// ─────────────────────────────────────────────────────────────────────────────
process {
    errorStrategy = 'retry'
    maxRetries    = 2

    // GPU process — mirrors your working sbatch command exactly
    withLabel: 'gpu' {
        queue          = 'GPU'
        time           = '1h'
        memory         = '16 GB'
        cpus           = 4
        clusterOptions = '--gres=gpu:1 --constraint=FP32'
    }

    // Tiny CPU processes for status writing and manifest aggregation
    withLabel: 'cpu_small' {
        queue  = 'short'       // adjust to your CPU partition name
        time   = '10min'
        memory = '2 GB'
        cpus   = 1
    }
}

// ─────────────────────────────────────────────────────────────────────────────
//  Work directory — MUST be on scratch/fast storage, not home
// ─────────────────────────────────────────────────────────────────────────────
workDir = "/scratch/$USER/nf-work"

// ─────────────────────────────────────────────────────────────────────────────
//  Reporting — crucial for tracking 1.2M jobs
// ─────────────────────────────────────────────────────────────────────────────
report {
    enabled   = true
    file      = "${params.tracedir}/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.tracedir}/trace.tsv"
    overwrite = true
    // Slurm job ID, exit code, resource usage — everything you need for auditing
    fields    = 'task_id,name,tag,status,exit,attempt,submit,start,complete,duration,realtime,cpus,memory,%cpu,%mem,rss,queue'
    sep       = '\t'
}

timeline {
    enabled   = true
    file      = "${params.tracedir}/timeline.html"
    overwrite = true
}
